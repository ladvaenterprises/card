{
  "name": "mitesh-ladva-digital-card",
  "version": "1.0.0",
  "private": true,
  "description": "Mitesh Ladva - Executive Digital Business Card & NFC Portfolio",
  "scripts": {
    "build": "node build.js",
    "start": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');http.createServer((req,res)=>{let f=req.url==='/'?'index.html':req.url.slice(1);fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end('Not found');}else{res.writeHead(200);res.end(d);}});}).listen(3000,()=>console.log('Running at http://localhost:3000'));\""
  }
}

